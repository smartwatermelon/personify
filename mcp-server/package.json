{
  "name": "@twistedmelonman/personify-mcp",
  "version": "0.5.0",
  "description": "MCP bridge that lets Claude Desktop run the personify skill via the Claude Code CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "prepare": "npm run build",
    "install-desktop-config": "npm run build && node scripts/install-desktop-config.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
